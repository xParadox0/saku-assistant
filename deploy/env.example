# Copy to the server (outside the repo), chmod 600, fill in. Never commit the filled file.
POSTGRES_PASSWORD=
SAKU_SECRET=                 # 64 random hex chars: python3 -c "import secrets; print(secrets.token_hex(32))"
SAKU_CF_TEAM=https://<team>.cloudflareaccess.com
SAKU_CF_AUD=                 # AUD tag of the Access application for the dashboard hostname
SAKU_BOT_USERNAME=           # without @
TELEGRAM_BOT_TOKEN=
TUNNEL_TOKEN=                # token of the dedicated tunnel for this app
SAKU_REGISTRATION=closed      # open only after Stage 0e (policy reviewed, export/delete, legal check)
SAKU_PENDING_CAP=50
SAKU_APPROVED_CAP=20
SAKU_POLICY_REVIEWED=         # set to the reviewed policy version to allow approvals
SAKU_CONTACT=                 # address shown in the privacy policy

# Own sign-in (HLD 3.11). Leave SAKU_AUTH_MODE unset to keep Cloudflare Access for all of /app.
SAKU_AUTH_MODE=own
SAKU_MAIL=graph
SAKU_GRAPH_TENANT=
SAKU_GRAPH_CLIENT_ID=
SAKU_GRAPH_CLIENT_SECRET=
SAKU_MAIL_FROM=
